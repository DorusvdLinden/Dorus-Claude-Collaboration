# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- code-server ---------------------------------------------------------
# Password for the code-server web login (Settings > browser prompt).
CODE_SERVER_PASSWORD=change-me-to-something-long

# --- Tailscale -------------------------------------------------------------
# Generate a key at https://login.tailscale.com/admin/settings/keys
# Use a REUSABLE key, not ephemeral -- an ephemeral key removes the node
# from your tailnet every time this container restarts, breaking access
# until you regenerate it.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# --- Claude Code (optional) ------------------------------------------------
# Leave blank to authenticate interactively with `claude login` inside the
# container instead (recommended if you're on a Pro/Max subscription rather
# than API/Console billing).
ANTHROPIC_API_KEY=

# --- Project path on the NAS -------------------------------------------
# Absolute path on the NAS host to bind-mount as the workspace.
PROJECTS_PATH=/volume1/projects

# --- Container user (permissions) -------------------------------------
# UID/GID inside the container that owns /home/coder and writes to
# PROJECTS_PATH. Set these to match the NAS user that owns PROJECTS_PATH
# (run `id <nas-username>` on the NAS via SSH) so the container can
# actually write to the bind-mounted folder. Defaults to 1000:1000.
CODER_UID=1000
CODER_GID=1000
